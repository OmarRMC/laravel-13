# Copia este archivo a terraform.tfvars y ajusta los valores.

# Obligatorio: tu IP publica, para restringir el SSH (puerto 22).
# Consiguela con: curl https://checkip.amazonaws.com
admin_cidr = "203.0.113.10/32"

# Opcionales - descomenta solo si quieres cambiar el valor por defecto (variables.tf):
# aws_region          = "us-east-1"
# aws_profile         = "nombre-del-perfil"  # el que configuraste con "aws configure --profile nombre"
# project_name        = "eventos-app"
# instance_type       = "t3.small"
# root_volume_size_gb = 20
